# ---------- Backend (backend/.env) ----------
APP_ENV=development                # development | test | production
LOG_LEVEL=INFO
DATABASE_URL=postgresql://routeproof:CHANGE_ME@localhost:5433/routeproof
JWT_SECRET_KEY=CHANGE_ME_generate_with_python_-c_"import secrets;print(secrets.token_urlsafe(48))"
ACCESS_TOKEN_EXPIRE_MINUTES=60       # idle timeout of the browser session (sliding, re-issued on activity)
SESSION_MAX_HOURS=12                 # absolute session lifetime, however active
COOKIE_SAMESITE=lax                  # lax | strict; COOKIE_SECURE defaults to true when APP_ENV=production
TRUST_PROXY_HEADERS=false            # true only behind the Next.js /api proxy (rate limits then use X-Forwarded-For)
LOG_FORMAT=json                      # json | text  (structured logs with request_id / processing_id, no personal data)
DATA_MODE=demo                     # demo | live  (label shown on dashboards)

# AI (live demo uses a real multimodal model)
AI_PROVIDER=claude                 # claude | manual | mock(tests only)
AI_API_KEY=CHANGE_ME_anthropic_api_key
AI_MODEL=claude-sonnet-5-5
AI_CONFIDENCE_THRESHOLD=0.85       # policy value; measure it with scripts/calibrate_confidence.py
AI_MAX_ATTEMPTS=2                  # provider calls per run for transient errors (timeout, rate_limit, network)
AI_RETRY_BACKOFF_SECONDS=2
AI_PROCESSING_STALE_MINUTES=10     # AI_PROCESSING older than this is routed to review as PROCESSING_STALLED
MAINTENANCE_INTERVAL_SECONDS=300   # in-process stale-job sweep; 0 disables
ORPHAN_GRACE_HOURS=24              # storage objects younger than this are never treated as orphans

# Private object storage
STORAGE_PROVIDER=local             # local | s3
STORAGE_BUCKET=
STORAGE_ENDPOINT=                  # e.g. S3-compatible endpoint (leave empty for AWS)
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

CORS_ALLOWED_ORIGINS=http://localhost:3000
UPLOAD_MAX_SIZE_BYTES=5242880          # hard safety limit per uploaded file
COMPRESSED_UPLOAD_LIMIT_BYTES=307200   # product rule: compressed POD strictly under 300 KB; at/above is flagged, not dropped
ORIGINAL_MAX_SIZE_BYTES=15728640       # full-resolution originals, sent after the compressed copy
CLIENT_LINK_MAX_DAYS=30                # longest a client POD-view link may live
BUSINESS_TIMEZONE=Asia/Kolkata         # delivery dates are local days; turnaround metrics start at local midnight
UPLOAD_LINK_EXPIRY_MINUTES=1440
PUBLIC_APP_URL=http://localhost:3000   # base URL used when building hired-driver links

# ---------- Frontend (frontend/.env.local) ----------
NEXT_PUBLIC_API_URL=http://localhost:8000   # production behind the proxy: set to "" (relative /api/v1)
# NEXT_PUBLIC_OFFICE_PHONE=+91XXXXXXXXXX     # optional: shows a "Call the office" button to drivers when something goes wrong
# API_PROXY_TARGET=https://routeproof-api.onrender.com   # production: proxy /api/v1 so the session cookie is first-party
