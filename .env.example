# ---------- Backend (backend/.env) ----------
APP_ENV=development                # development | test | production
LOG_LEVEL=INFO
DATABASE_URL=postgresql://routeproof:CHANGE_ME@localhost:5433/routeproof
JWT_SECRET_KEY=CHANGE_ME_generate_with_python_-c_"import secrets;print(secrets.token_urlsafe(48))"
ACCESS_TOKEN_EXPIRE_MINUTES=480
DATA_MODE=demo                     # demo | live  (label shown on dashboards)

# AI (live demo uses a real multimodal model)
AI_PROVIDER=claude                 # claude | manual | mock(tests only)
AI_API_KEY=CHANGE_ME_anthropic_api_key
AI_MODEL=claude-sonnet-5-5
AI_CONFIDENCE_THRESHOLD=0.85       # implementation assumption, not a calibrated guarantee

# Private object storage
STORAGE_PROVIDER=local             # local | s3
STORAGE_BUCKET=
STORAGE_ENDPOINT=                  # e.g. S3-compatible endpoint (leave empty for AWS)
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

CORS_ALLOWED_ORIGINS=http://localhost:3000
UPLOAD_MAX_SIZE_BYTES=5242880
UPLOAD_LINK_EXPIRY_MINUTES=1440
PUBLIC_APP_URL=http://localhost:3000   # base URL used when building hired-driver links

# ---------- Frontend (frontend/.env.local) ----------
NEXT_PUBLIC_API_URL=http://localhost:8000
